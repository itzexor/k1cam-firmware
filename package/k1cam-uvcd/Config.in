config BR2_PACKAGE_K1CAM_UVCD
	bool "k1cam-uvcd"
	select BR2_PACKAGE_THINGINO_RAPTOR_HAL
	select BR2_PACKAGE_THINGINO_SENSOR_INFO
	help
	  Minimal fixed-function UVC webcam daemon for T31 + GC2083.

	  Fuses ISP/encoder bring-up and the UVC gadget bridge into one
	  process. Standard image controls are exposed on the UVC
	  Processing Unit; nonstandard ISP controls on Extension Unit 4.

	  Requires the uvcd gadget descriptors in the kernel's
	  g_webcam.
