#!/bin/sh
# S31uvcd -- minimal on-demand ISP -> UVC webcam daemon (T31 + GC2083 only)
#
# init runs the supervisor from inittab ("S31uvcd supervise", added by the
# board's post-build script) and respawns it, and the supervisor respawns
# uvcd, so nothing can leave uvcd stopped: that would take the USB gadget
# down, and with it the ACM console someone may be typing into. "start"
# only loads the gadget; "stop" outside shutdown amounts to a restart.

DAEMON=/usr/bin/uvcd
SUPERVISOR_PID=/var/run/uvcd-supervisor.pid
READY=/var/run/uvcd.ready
VIDEO=/dev/video0

set_usb_device_mode() {
	# Fixed T31 device-mode sequence; this board has no host-mode connector.
	devmem 0x13500000 32 0x001100cc
	devmem 0x10000040 32 0x0b000096
	devmem 0x10000040 32 0x0b000FFF
}

read_serial() {
	serial=
	for address in 0x13540200 0x13540204 0x13540208 0x1354023C; do
		value=$(devmem "$address" 2>/dev/null) || return 1
		serial="$serial$(printf '%u' "$value")"
	done
	printf '%s\n' "$serial"
}

# Poll a condition in 50ms steps. Every wait in start() is on the path to
# the host seeing the camera, and polling in whole seconds rounds each one
# up to the next second. Usage: wait_for <max-steps> <command...>
wait_for() {
	n=$1
	shift
	while [ "$n" -gt 0 ]; do
		"$@" && return 0
		sleep 0.05
		n=$((n - 1))
	done
	"$@"
}

# Readiness is published only after all UVC subscriptions are installed.
uvcd_ready() {
	[ -s "$READY" ] && kill -0 "$(cat "$READY")" 2>/dev/null
}

pid_gone() {
	! kill -0 "$1" 2>/dev/null
}

# Wait until a pid has exited, up to max-steps of 50ms.
wait_gone() {
	wait_for "$1" pid_gone "$2"
}

# A supervisor is done once the pidfile no longer names it: its trap removes
# the file last thing, and init's next supervisor writes its own pid.
supervisor_gone() {
	[ "$(cat "$SUPERVISOR_PID" 2>/dev/null)" != "$1" ]
}

supervise() {
	echo $$ >"$SUPERVISOR_PID"
	# A supervisor killed with SIGKILL leaves its uvcd running: never start
	# a second one next to it.
	stray=$(cat "$READY" 2>/dev/null)
	if [ -n "$stray" ] && grep -q "$DAEMON" "/proc/$stray/cmdline" 2>/dev/null; then
		kill "$stray" 2>/dev/null
		wait_gone 100 "$stray" || kill -KILL "$stray" 2>/dev/null
	fi
	# At boot init only gets here after rcS, which loaded g_webcam; if that
	# failed, wait rather than spin (init does not rate-limit respawns).
	while [ ! -e "$VIDEO" ]; do
		sleep 1
	done
	child=
	sleeper=
	trap '[ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null; disconnect_gadget; if [ -n "$child" ]; then
		kill "$child" 2>/dev/null
		(sleep 5; kill -KILL "$child" 2>/dev/null) &
		reaper=$!
		wait "$child" 2>/dev/null
		kill "$reaper" 2>/dev/null
	fi; rm -f "$READY" "$SUPERVISOR_PID"; exit 0' TERM INT
	backoff=1
	while :; do
		disconnect_gadget
		rm -f "$READY"
		"$DAEMON" -s -d "$VIDEO" &
		child=$!
		if wait_for 200 uvcd_ready; then
			connect_gadget
		else
			kill -KILL "$child" 2>/dev/null
		fi
		started=$(cut -d. -f1 /proc/uptime)
		wait "$child"
		child=
		disconnect_gadget
		rm -f "$READY"
		now=$(cut -d. -f1 /proc/uptime)
		[ $((now - started)) -ge 30 ] && backoff=1
		sleep "$backoff" &
		sleeper=$!
		wait "$sleeper"
		sleeper=
		[ "$backoff" -ge 16 ] || backoff=$((backoff * 2))
	done
}

# Resolved once, in the current shell rather than a $(...) subshell so the
# result sticks: it is a find across all of /sys/devices, and start() needs
# it twice on the way to enumeration.
resolve_soft_connect() {
	[ -n "$SOFT_CONNECT" ] ||
		SOFT_CONNECT=$(find /sys/devices -name soft_connect -path "*/dwc2/*" 2>/dev/null | head -1)
}

# soft_connect is absolute: repeating either command is harmless. uvcd
# opening /dev/video0 doesn't connect on its own after a disconnect here, so
# the host only sees the camera once connect_gadget runs. Before g_webcam is
# loaded there is no gadget driver and the write fails; nothing to do then.
disconnect_gadget() {
	resolve_soft_connect
	[ -n "$SOFT_CONNECT" ] || return 0
	echo disconnect >"$SOFT_CONNECT" 2>/dev/null
	return 0
}

connect_gadget() {
	resolve_soft_connect
	[ -n "$SOFT_CONNECT" ] || return 0
	echo connect >"$SOFT_CONNECT" 2>/dev/null
	return 0
}

case "$1" in
	supervise)
		supervise
		;;
	start)
		if [ -s "$SUPERVISOR_PID" ] && kill -0 "$(cat "$SUPERVISOR_PID")" 2>/dev/null; then
			exit 0
		fi
		echo "Starting uvcd..."
		set_usb_device_mode
		if [ ! -e "$VIDEO" ]; then
			# g_webcam composes a CDC-ACM function alongside UVC on its own
			# (webcam.c requests "acm" via the kernel's usbfunc: module
			# alias); this is belt-and-suspenders in case that autoload
			# path ever fails at boot -- harmless no-op otherwise.
			modprobe usb_f_acm 2>/dev/null
			# USB serial number: the SoC's efuse ID, so every camera has its
			# own and two on one host get distinct /dev/v4l/by-id and
			# /dev/serial/by-id names. Left out if it can't be read.
			serial=$(read_serial 2>/dev/null)
			modprobe g_webcam ${serial:+iSerialNumber=$serial} || {
				echo "Failed to load g_webcam"
				exit 1
			}
		fi
		if ! wait_for 100 test -e "$VIDEO"; then
			echo "UVC video device not available"
			exit 1
		fi
		# The supervisor itself is init's (see the top of this file). It
		# connects the gadget once uvcd has the video node open and its UVC
		# events subscribed, so the host's first SETUP requests are answered.
		;;
	stop)
		# Run from the ACM console, the supervisor's disconnect hangs up the
		# shell that ran this; finish anyway.
		trap '' HUP
		echo "Stopping uvcd..."
		# The supervisor disconnects the gadget itself as it goes. Doing it
		# here first would hang this script up before it got to kill the
		# supervisor, leaving uvcd running and the camera disconnected with
		# nothing to reconnect it.
		if [ -s "$SUPERVISOR_PID" ]; then
			supervisor=$(cat "$SUPERVISOR_PID")
			kill "$supervisor" 2>/dev/null
			wait_for 160 supervisor_gone "$supervisor" || exit 1
		fi
		;;
	restart)
		trap '' HUP
		"$0" stop && "$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
