#!/bin/sh
# S31uvcd -- minimal on-demand ISP -> UVC webcam daemon (T31 + GC2083 only)

DAEMON=/usr/bin/uvcd

# Poll a condition in 50ms steps. Every wait in start() is on the path to
# the host seeing the camera, and polling in whole seconds rounds each one
# up to the next second. Usage: wait_for <max-steps> <command...>
wait_for() {
	n=$1
	shift
	while [ "$n" -gt 0 ]; do
		"$@" && return 0
		sleep 0.05
		n=$((n - 1))
	done
	"$@"
}

# True once uvcd holds /dev/video0 open.
uvcd_ready() {
	pid=$(pidof uvcd) || return 1
	for fd in /proc/$pid/fd/*; do
		[ "$(readlink "$fd" 2>/dev/null)" = "/dev/video0" ] && return 0
	done
	return 1
}

# Resolved once, in the current shell rather than a $(...) subshell so the
# result sticks: it is a find across all of /sys/devices, and start() needs
# it twice on the way to enumeration.
resolve_soft_connect() {
	[ -n "$SOFT_CONNECT" ] ||
		SOFT_CONNECT=$(find /sys/devices -name soft_connect -path "*/dwc2/*" 2>/dev/null | head -1)
}

disconnect_gadget() {
	resolve_soft_connect
	[ -n "$SOFT_CONNECT" ] && echo disconnect >"$SOFT_CONNECT"
}

connect_gadget() {
	resolve_soft_connect
	[ -n "$SOFT_CONNECT" ] && echo connect >"$SOFT_CONNECT"
}

case "$1" in
	start)
		echo "Starting uvcd..."
		# Only a restart needs the pause: it gives the host time to see the
		# unplug before we reconnect. At boot g_webcam isn't loaded yet, nothing
		# is attached, and a sleep here is pure delay before enumeration.
		disconnect_gadget
		grep -q '^g_webcam ' /proc/modules 2>/dev/null && sleep 1
		if [ -x /usr/sbin/usb-role ]; then
			usb-role -m device 2>/dev/null
		fi
		if [ ! -e /dev/video0 ]; then
			# g_webcam composes a CDC-ACM function alongside UVC on its own
			# (webcam.c requests "acm" via the kernel's usbfunc: module
			# alias); this is belt-and-suspenders in case that autoload
			# path ever fails at boot -- harmless no-op otherwise.
			modprobe usb_f_acm 2>/dev/null
			# USB serial number: the SoC's efuse ID, so every camera has its
			# own and two on one host get distinct /dev/v4l/by-id and
			# /dev/serial/by-id names. Left out if it can't be read.
			serial=$(soc -s 2>/dev/null)
			modprobe g_webcam ${serial:+iSerialNumber=$serial} || {
				echo "Failed to load g_webcam"
				exit 1
			}
		fi
		if ! wait_for 100 test -e /dev/video0; then
			echo "UVC video device not available"
			exit 1
		fi
		start-stop-daemon -S -b -x "$DAEMON" -- -d /dev/video0
		# uvcd must have /dev/video0 open and its UVC events subscribed before
		# the gadget connects, or the host's first SETUP requests go unanswered.
		if ! wait_for 200 uvcd_ready; then
			echo "uvcd failed to start"
			exit 1
		fi
		connect_gadget
		;;
	stop)
		echo "Stopping uvcd..."
		start-stop-daemon -K -x "$DAEMON"
		disconnect_gadget
		;;
	restart)
		$0 stop
		$0 start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
