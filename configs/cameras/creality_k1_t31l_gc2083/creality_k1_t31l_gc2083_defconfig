# NAME: Creality K1 Camera (T31L, GC2083, USB)
# FRAG: soc-xburst1 core
BR2_ETHERNET=n
BR2_INGENIC_SOC_MODEL="t31l"
BR2_ISP_CLK_200MHZ=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="$(BR2_EXTERNAL_THINGINO_PATH)/../thingino-linux"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="4727879284cf8f1314e1fd66740573ef70efd057"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_THINGINO_PATH)/configs/cameras/creality_k1_t31l_gc2083/busybox.fragment"
BR2_PACKAGE_DROPBEAR=n
BR2_PACKAGE_IFUPDOWN_SCRIPTS=n
BR2_PACKAGE_K1CAM_UVCD=y
BR2_PACKAGE_MDNSD=n
BR2_PACKAGE_MDNSD_HTTP_SERVICE=n
BR2_PACKAGE_THINGINO_KOPT_DWC2=y
BR2_PACKAGE_THINGINO_KOPT_DWC2_OTG=y
BR2_PACKAGE_THINGINO_KOPT_IPV6=n
BR2_PACKAGE_THINGINO_KOPT_LEDS=n
BR2_PACKAGE_THINGINO_KOPT_USB_GADGET_ONLY=y
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_THINGINO_PATH)/configs/cameras/creality_k1_t31l_gc2083/post-build.sh $(BR2_EXTERNAL_THINGINO_PATH)/scripts/rootfs_script.sh $(BR2_EXTERNAL_THINGINO_PATH)/configs/cameras/creality_k1_t31l_gc2083/post-build.sh"
BR2_SENSOR_1_NAME="gc2083"
BR2_THINGINO_AUDIO=n
BR2_THINGINO_DEV_WEBCAM=y
BR2_THINGINO_PACKAGES=n
FLASH_SIZE_MB=8

# k1cam: the USB UVC webcam module of the Creality K1 3D printer (T31L,
# GC2083, 8 MB NOR). Built on thingino's Buildroot tree; the closest thingino
# board is vanhua_l34_t31l_gc2083_eth, minus everything this one lacks: no IR,
# motor, mic, Wi-Fi or Ethernet.
#
# Kernel: our fork of gtxaspec/thingino-linux, checked out as a sibling of
# this repo (../thingino-linux) and pinned by SHA. The gadget descriptors
# (drivers/usb/gadget/webcam.c) are commits on its k1cam branch, not patches
# here. The BR2_LINUX_KERNEL_CUSTOM_REPO_* lines override core.fragment, which
# is applied before this file, and pinning replaces its `git ls-remote`
# branch lookup: the kernel only changes when that SHA does, so bump it after
# committing to the fork.
#
# Webcam: k1cam-uvcd (package/k1cam-uvcd), a standalone T31+GC2083 UVC webcam
# daemon rather than one of thingino's streamers. It selects the raptor HAL
# (and through it libimp and the sensor driver named by BR2_SENSOR_1_NAME),
# BR2_PACKAGE_THINGINO_KOPT_GADGET_WEBCAM and USB role switching, so
# thingino's webcam fragment (raptor.conf keys, RTSP/WebRTC selects) is not
# applied. The sensor, ISP and encoder only run while a host streams.
#
# Packages: no network, so nothing that talks to one is built: no SSL
# library, dropbear, curl, IPv6, package manager or web UI. Also off: host-
# mode USB ethernet drivers (the port is only ever a device) and LEDs (none
# on the board). thingino's system menu implies these rather than selecting
# them, so a board can turn them off.
#
# ISP clock: 200 MHz, as the stock firmware runs it. The module default is
# 100 MHz, where the ISP can't upscale far: zoom broke past 131 at 1080p,
# 250 at 1280x960 and 342 at 720p; at 200 MHz only 1080p stops, past 300.
# uvcd reads the clock and caps zoom to match. Set here explicitly: the
# menu's own default never reaches the module options (thingino.mk works
# out isp_clk= before Kconfig defaults exist).
#
# Boot services: this board is a USB-powered webcam with no network, so
# post-build.sh (run both before and after thingino's rootfs_script.sh)
# removes the network, time, sysadmin and LED services that thingino's
# global overlay installs unconditionally, and puts the USB ACM console and
# uvcd's supervisor under init. Kconfig cannot do this -- those scripts are
# not owned by any package option.
#
# GPIO: stock U-Boot sets "gpio_default=18O". GPIO 18 (PA18) is the GC2083
# reset line, and the sensor driver (reset_gpio=18) requests it and pulses
# reset on every probe. Do not set it in BR2_THINGINO_GPIO_LIST: S05gpio
# exports the pin through sysfs and keeps it claimed, so the first probe
# after boot fails to request it and skips the reset ("gpio request fail
# 18" with a stack dump). The driver then frees the pin on remove, which
# also drops the export, so only the first stream ran on an unreset sensor.
# Left alone, PA18 is an input that reads high, so the sensor is still out
# of reset before its first probe, as with the stock gpio_default.
