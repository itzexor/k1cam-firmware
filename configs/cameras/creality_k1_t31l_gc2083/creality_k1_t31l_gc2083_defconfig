BR2_PACKAGE_MDNSD_HTTP_SERVICE=n
BR2_PACKAGE_TELEGRAMBOT=n
BR2_PACKAGE_THINGINO_AGENT=n
BR2_PACKAGE_THINGINO_DIAG=n
BR2_PACKAGE_THINGINO_HA=n
