export HOME=/root
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export EDITOR=vi
export PAGER=less
export HISTFILE=/tmp/.ash_history
export HISTSIZE=500
export HISTFILESIZE=500

alias logs='dmesg'
alias uvlog='dmesg | grep uvcd'
alias ll='ls -alF'

if [ -n "$PS1" ]; then
	printf '\033[1;36mCreality K1 USB camera\033[0m  '
	printf 'uvcd: '
	pidof uvcd >/dev/null && printf '\033[1;32mrunning\033[0m\n' || printf '\033[1;31mstopped\033[0m\n'
	(
		. /etc/os-release
		slot=$(sed -n 's/.*k1cam\.slot=\([ab]\).*/\1/p' /proc/cmdline)
		boot=$(sed -n 's/.*k1cam\.boot=\([a-z]*\).*/\1/p' /proc/cmdline)
		printf '  image  %s\n' "$BUILD_ID"
		printf '  kernel %s, %s\n' "$KERNEL_COMMIT" "$(uname -v)"
		printf '  slot   %s (%s boot)\n\n' "${slot:-?}" "${boot:-unknown}"
	)
	printf '  uvcdctl list | describe [ctl]    controls: values, ranges, meanings\n'
	printf '  uvcdctl get <ctl> | set <ctl> <v> | reset | keyframe\n'
	printf '  uvlog, logs                      uvcd log, whole kernel log\n'
	printf '  /etc/init.d/S31uvcd restart      restart uvcd; USB and this shell drop 1.5 s\n'
	printf '  cat /proc/jz/isp/isp-m0          live ISP state: AE, AWB, anti-flicker\n'
	printf '  fw_printenv                      U-Boot environment (slots, trial)\n'
	printf '  Controls persist in /etc/uvcd.conf. Anything written under / is kept\n'
	printf '  in this slot'"'"'s layer of the data partition (/overlay/slots/<slot>);\n'
	printf '  /opt is shared by both slots; /tmp and /run are RAM.\n\n'
	export PS1='\[\e[38;5;208m\]k1\[\e[0m\]:\[\e[38;5;153m\]\w\[\e[0m\]# '
fi
