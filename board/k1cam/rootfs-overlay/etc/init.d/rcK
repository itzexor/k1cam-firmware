#!/bin/sh

printf '\n\nGoing to reboot!\n'

# These are the only stateful services. Keep the watchdog armed until after
# sync so it remains the fallback if the kernel reboot path hangs.
/etc/init.d/S31uvcd stop
/etc/init.d/S01seedrng stop
sync

WD_PID=$(cat /var/run/watchdog.pid 2>/dev/null)
[ -n "$WD_PID" ] && kill -9 "$WD_PID" 2>/dev/null
killall -9 watchdog 2>/dev/null || true

reboot -f 2>/dev/null || echo b >/proc/sysrq-trigger 2>/dev/null

exit 0
